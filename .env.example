# ============================================================
# Supabase environment variables
# ============================================================
# These two are SAFE to expose to the browser (NEXT_PUBLIC_*).
# They are the anon/public keys — NOT the service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. This key is NEVER exposed to the browser and must not
# be prefixed with NEXT_PUBLIC_. It is used only for privileged server
# operations (e.g. restoring sessions during migrations). Do not commit.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Groq (AI reflection engine) — server-side only
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ============================================================
# Razorpay payments — TEST MODE
# ============================================================
# RAZORPAY_KEY_ID is the (test) Key ID. It is safe to show in the browser and
# is returned to the client only inside the create-order response.
RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET is SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Used to
# verify Razorpay Checkout payment signatures. Do not commit.
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET is SERVER-ONLY. Verifies Razorpay webhook signatures.
RAZORPAY_WEBHOOK_SECRET=
# Fixed price in paise (₹79 = 7900). Server-side single source of truth.
MIRAAI_PRICE_PAISE=7900
# Set to "1" to switch ON the server-side paywall (402 when not entitled).
# Leave unset/off so the experience stays free during development/testing.
PAYMENTS_ENFORCE=



